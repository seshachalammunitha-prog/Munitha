		},
		"ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS'"
		},
		"AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL'"
		},
		"lnk_onprem_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lnk_onprem_sql'"
		},
		"ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datalakemunitha.dfs.core.windows.net/"
		},
		"AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "munitha-db-server.database.windows.net"
		},
		"AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "munitha-db"
		},
		"AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "munithaadmin"
		},
		"lnk_onprem_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "MUNITHA"
		},
		"lnk_onprem_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "munitha_db"
		},
		"lnk_onprem_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dedeepya"
		}
